# Application
PRM_APP_NAME=Pokemon Resale Manager
PRM_ENV=development
PRM_HOST=127.0.0.1
PRM_PORT=8000

# Leave DATABASE_URL unset to use ./data/pokemon_resale_manager.db
# DATABASE_URL=sqlite:///./data/pokemon_resale_manager.db

# eBay Sell API / OAuth
# Start with sandbox. Switch to production only after sandbox validation.
EBAY_ENVIRONMENT=sandbox
EBAY_CLIENT_ID=
EBAY_CLIENT_SECRET=

# eBay calls this the OAuth Redirect URL name (RuName). It is NOT the literal
# callback URL. Configure this RuName in the eBay Developer Portal so its
# Auth Accepted URL points to this app's /ebay/oauth/callback endpoint.
EBAY_RUNAME=

EBAY_MARKETPLACE_ID=EBAY_US
EBAY_LOCALE=en-US

# 183454 is eBay's Collectible Card Games / Individual Cards leaf category,
# used as the v0.5 Pokemon-single default. It can be overridden per draft.
EBAY_DEFAULT_CATEGORY_ID=183454
